{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "varunsmail",
  "account_id": "2e7a118a3e9bcfea64790a7667fac5ae",
  "main": "src/main.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mail.varunaditya.space",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../mail/build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/agents/*",
      "/health",
      "/.well-known/*",
      "/mcp*",
      "/sse*",
      "/a8n/*"
    ]
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "varunsmail-db",
      "database_id": "5c12f95f-366e-40d3-a1b7-a9fe82f9796a"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "varunsmail-threads"
    },
    {
      "binding": "VECTORIZE_MESSAGE",
      "index_name": "varunsmail-messages"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THREADS_BUCKET",
      "bucket_name": "varunsmail-threads"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "gmail_history_id",
      "id": "f49eb374283a4d73b2b9d3794aaca90c"
    },
    {
      "binding": "gmail_processing_threads",
      "id": "22efaed4243d47eb8a459636ee5b3820"
    },
    {
      "binding": "subscribed_accounts",
      "id": "30ec8bb266cc4e6a99c700af282e3a8a"
    },
    {
      "binding": "connection_labels",
      "id": "3dfd3acce2904c2682d0d1ce5bca6727"
    },
    {
      "binding": "prompts_storage",
      "id": "6605cedca0114d3785bcd1ba6c64ad27"
    },
    {
      "binding": "gmail_sub_age",
      "id": "3d764aeeabb14919b45c3af28cf588f3"
    },
    {
      "binding": "pending_emails_status",
      "id": "123c9b6b5c2a4551bcc0ad52beaa7dc0"
    },
    {
      "binding": "pending_emails_payload",
      "id": "7f075c680bf44d34881fb8595c88ab82"
    },
    {
      "binding": "scheduled_emails",
      "id": "7d9221f725cf4f5bb6cae207f943d1aa"
    },
    {
      "binding": "snoozed_emails",
      "id": "95d427cbcbc748a6b8bbb98bf4dd6abf"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ZERO_AGENT",
        "class_name": "ZeroAgent"
      },
      {
        "name": "ZERO_MCP",
        "class_name": "ZeroMCP"
      },
      {
        "name": "ZERO_DB",
        "class_name": "ZeroDB"
      },
      {
        "name": "ZERO_DRIVER",
        "class_name": "ZeroDriver"
      },
      {
        "name": "THINKING_MCP",
        "class_name": "ThinkingMCP"
      },
      {
        "name": "WORKFLOW_RUNNER",
        "class_name": "WorkflowRunner"
      },
      {
        "name": "THREAD_SYNC_WORKER",
        "class_name": "ThreadSyncWorker"
      },
      {
        "name": "SHARD_REGISTRY",
        "class_name": "ShardRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ZeroAgent",
        "ZeroMCP",
        "ZeroDB",
        "ZeroDriver",
        "ThinkingMCP",
        "WorkflowRunner",
        "ThreadSyncWorker",
        "ShardRegistry"
      ]
    }
  ],
  "workflows": [
    {
      "binding": "SYNC_THREADS_WORKFLOW",
      "class_name": "SyncThreadsWorkflow",
      "name": "varunsmail-sync-threads"
    },
    {
      "binding": "SYNC_THREADS_COORDINATOR_WORKFLOW",
      "class_name": "SyncThreadsCoordinatorWorkflow",
      "name": "varunsmail-sync-coordinator"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "thread-queue-varunsmail",
        "binding": "thread_queue"
      },
      {
        "queue": "gmail-sync-varunsmail",
        "binding": "gmail_sync_queue"
      },
      {
        "queue": "gmail-index-varunsmail",
        "binding": "gmail_index_queue"
      },
      {
        "queue": "subscribe-queue-varunsmail",
        "binding": "subscribe_queue"
      },
      {
        "queue": "send-email-queue-varunsmail",
        "binding": "send_email_queue"
      }
    ],
    "consumers": [
      {
        "queue": "gmail-sync-varunsmail",
        "max_batch_size": 2,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "varunsmail-thread-failures"
      },
      {
        "queue": "gmail-index-varunsmail",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 120,
        "dead_letter_queue": "varunsmail-thread-failures"
      },
      {
        "queue": "thread-queue-varunsmail",
        "max_batch_size": 2,
        "max_concurrency": 1,
        "max_retries": 10,
        "retry_delay": 60,
        "dead_letter_queue": "varunsmail-thread-failures"
      },
      {
        "queue": "subscribe-queue-varunsmail"
      },
      {
        "queue": "send-email-queue-varunsmail"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT_10",
      "namespace_id": "26090810",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMIT_60",
      "namespace_id": "26090860",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMIT_120",
      "namespace_id": "260908120",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "OWNER_EMAIL": "varunaditya.aga@gmail.com",
    "COOKIE_DOMAIN": "mail.varunaditya.space",
    "BETTER_AUTH_URL": "https://mail.varunaditya.space",
    "VITE_PUBLIC_BACKEND_URL": "https://mail.varunaditya.space",
    "VITE_PUBLIC_APP_URL": "https://mail.varunaditya.space",
    "GOOGLE_REDIRECT_URI": "https://mail.varunaditya.space/api/auth/callback/google",
    "DISABLE_CALLS": "true",
    "ENABLE_MEET": "false",
    "DROP_AGENT_TABLES": "false",
    "THREAD_SYNC_MAX_COUNT": "60",
    "THREAD_SYNC_LOOP": "true",
    "DISABLE_WORKFLOWS": "true",
    "OPENAI_MODEL": "gpt-4.1",
    "OPENAI_MINI_MODEL": "gpt-4.1-mini",
    "GMAIL_POLL_BACKFILL_COUNT": "10"
  }
}
